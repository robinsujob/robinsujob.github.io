          ":instance/*"
         ]
        ]
       }
      },
      {
       "Action": "ssm:StartSession",
       "Effect": "Allow",
       "Resource": {
        "Fn::Join": [
         "",
         [
          "arn:aws:ssm:",
          {
           "Ref": "AWS::Region"
          },
          "::document/AWS-StartPortForwardingSession"
         ]
        ]
       }
      },
      {
       "Action": [
        "ssm:ResumeSession",
        "ssm:TerminateSession"
       ],
       "Effect": "Allow",
       "Resource": {
        "Fn::Join": [
         "",
         [
          "arn:aws:ssm:",
          {
           "Ref": "AWS::Region"
          },
          ":",
          {
           "Ref": "AWS::AccountId"
          },
          ":session/${aws:username}-*"
         ]
        ]
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "PolicyName": "SSMInlinePolicyA5E693AC",
    "Users": [
