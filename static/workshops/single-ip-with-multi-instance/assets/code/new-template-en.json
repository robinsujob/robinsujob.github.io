  "SSMInlinePolicyA5E693AC": {
   "Type": "AWS::IAM::Policy",
   "Properties": {
    "PolicyDocument": {
     "Statement": [
      {
       "Action": "ssm:StartSession",
       "Condition": {
        "StringLike": {
         "ssm:resourceTag/SSM-Connect": {
          "Fn::Join": [
           "-",
           [
            "SSM",
            {
             "Ref": "AWS::Region"
            },
